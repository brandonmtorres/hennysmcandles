# ---------------------------------------------------------------------------
# Local development environment.  NEVER commit this file (see .gitignore).
# ---------------------------------------------------------------------------

# Postgres.  DATABASE_URL is what the app runs on; point it at the pooled
# connection your host provides (Neon, Supabase and Vercel all give you one),
# because serverless functions open connections faster than Postgres can
# afford them.  DIRECT_URL bypasses the pooler and is used only by
# `prisma migrate`, which needs a real session to take locks and issue DDL.
# On a plain Postgres with no pooler, set both to the same value.
DATABASE_URL="postgresql://user:password@host:5432/hennysmcandles?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/hennysmcandles?schema=public"

# Public site origin — used for Square redirects and email links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js session signing secret (generated below).
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Square.  Sandbox credentials come from developer.squareup.com — create an
# application, then read them from its Sandbox tab.  Nothing here touches real
# money until SQUARE_ENVIRONMENT is set to production.
#
#   SQUARE_ACCESS_TOKEN            application → Sandbox → Access token
#   SQUARE_LOCATION_ID             application → Sandbox → Locations
#   SQUARE_ENVIRONMENT             sandbox (default) or production
#   SQUARE_WEBHOOK_SIGNATURE_KEY   shown when the webhook subscription is made
#   SQUARE_WEBHOOK_URL             the subscription's URL, character for
#                                  character.  Square signs the URL along with
#                                  the body, so a trailing slash or an http/https
#                                  mismatch here fails every delivery.
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
SQUARE_ENVIRONMENT="sandbox"
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_URL="http://localhost:3000/api/webhooks/square"

# Email.  Leave RESEND_API_KEY blank to write emails to .mail-preview/ instead
# of sending them.  Set it and mail sends for real — no code change needed.
RESEND_API_KEY=""
EMAIL_FROM="Hennys M. Homemade Candles <support@hennysmcandles.com>"
EMAIL_REPLY_TO="support@hennysmcandles.com"
OWNER_NOTIFICATION_EMAIL="support@hennysmcandles.com"

# Seeded portal owner account.
PORTAL_OWNER_EMAIL="hennys@hennysmcandles.com"
PORTAL_OWNER_PASSWORD=""

# How to work out a visitor's IP address, which the rate limits are counted
# against.  Both may be left blank: limits then apply to everyone together
# rather than per visitor, which is safe but blunt.  Set one to match whatever
# you deploy behind, and never guess — an address we wrongly believe is an
# address an attacker can invent to slip past the limits.
#
#   CLIENT_IP_HEADER    the header your proxy sets and overwrites.  Preferred.
#                       Cloudflare: cf-connecting-ip   Vercel: x-vercel-forwarded-for
#   TRUSTED_PROXY_HOPS  number of proxies of your own in front, if instead you
#                       rely on x-forwarded-for.  One nginx in front means 1.
CLIENT_IP_HEADER=""
TRUSTED_PROXY_HOPS="0"

# Product images.  Leave every S3_ variable blank and uploads are written to
# public/uploads on local disk, which is right for development and wrong for
# almost any deployment — most hosts wipe that directory on each deploy.
#
# Any S3-compatible bucket works: Cloudflare R2, Amazon S3, DigitalOcean
# Spaces, Backblaze B2, Supabase Storage.  The bucket must serve /uploads/*
# publicly, and S3_PUBLIC_URL is the domain it is served from — it is also the
# only external image host the Content Security Policy will allow, so it is
# read at build time and a change to it needs a rebuild.
#
#   S3_ENDPOINT   required for everything except Amazon S3 itself, e.g.
#                 https://<account>.r2.cloudflarestorage.com
#   S3_REGION     "auto" suits R2; use the real region on S3
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# A shared password across the whole site, for showing work in progress.
# Anyone opening the site is asked for it once, through the browser's own box.
# Leave blank to remove the curtain entirely — that is the setting for launch.
# Square's webhook stays reachable either way; it is verified by signature.
SITE_PASSWORD=""
