# ---------------------------------------------------------------------------
# Local development environment.  NEVER commit this file (see .gitignore).
# ---------------------------------------------------------------------------

DATABASE_URL="file:./dev.db"

# Public site origin — used for Stripe redirects and email links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js session signing secret (generated below).
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Stripe — test keys.  Replace with live keys to go live.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email.  Leave RESEND_API_KEY blank to write emails to .mail-preview/ instead
# of sending them.  Set it and mail sends for real — no code change needed.
RESEND_API_KEY=""
EMAIL_FROM="Hennys M. Homemade Candles <orders@hennysmcandles.com>"
EMAIL_REPLY_TO="hello@hennysmcandles.com"
OWNER_NOTIFICATION_EMAIL="hello@hennysmcandles.com"

# Seeded portal owner account.
PORTAL_OWNER_EMAIL="hennys@hennysmcandles.com"
PORTAL_OWNER_PASSWORD=""
